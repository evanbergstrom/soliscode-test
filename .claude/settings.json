{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.m2/settings.xml)",
      "Edit(~/.m2/settings.xml)",
      "Write(~/.m2/settings.xml)",
      "Bash(cat ~/.m2/settings.xml:*)",
      "Bash(mvn help:effective-settings:*)"
    ]
  },
  "enabledPlugins": {
    "soliscode@soliscode-0.1.14": true
  },
  "extraKnownMarketplaces": {
    "soliscode-0.1.14": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/soliscode/soliscode-parent.git",
        "ref": "v0.1.14"
      }
    }
  }
}
