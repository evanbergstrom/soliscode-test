{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.m2/settings.xml)",
      "Edit(~/.m2/settings.xml)",
      "Write(~/.m2/settings.xml)",
      "Bash(cat ~/.m2/settings.xml:*)",
      "Bash(mvn help:effective-settings:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-maven-settings.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
