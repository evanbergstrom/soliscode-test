<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The shared parent: versions, plugins and every gate (soliscode-parent, docs/design/reference/build-and-test.md) -->
  <parent>
    <groupId>com.soliscode</groupId>
    <artifactId>soliscode-parent</artifactId>
    <version>0.1.8</version>
    <relativePath/>
  </parent>

  <groupId>com.soliscode</groupId>
  <artifactId>soliscode-test</artifactId>
  <!-- 0.1-SNAPSHOT on main; scripts/release/release.sh sets 0.1.N for a release (RELEASES.md) -->
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>SolisCode Test</name>
  <description>Library for writing unit tests for classes that implement standard interfaces</description>
  <url>https://soliscode.org</url>
  <inceptionYear>2025</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE.txt</url>
    </license>
  </licenses>

  <!-- People and Contributors -->
  <developers>
    <developer>
      <id>evanbergstrom</id>
      <name>Evan Bergstrom</name>
      <email>evan.bergstrom@icloud.com</email>
      <organization>soliscode</organization>
      <url>https://www.evanbergstrom.com</url>
      <timezone>America/New_York</timezone>
      <roles>
        <role>owner</role>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <!-- Source Control -->
  <scm>
    <connection>scm:git@gitlab.com:soliscode/soliscode-test.git</connection>
    <developerConnection>scm:git:ssh://git@gitlab.com:soliscode/soliscode-test.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://gitlab.com/soliscode/soliscode-test.git</url>
  </scm>

  <properties>
    <revision>0.1-SNAPSHOT</revision>
    <!-- The line coverage the tests must keep (build-and-test.md, "Coverage") -->
    <jacoco.minimum.coverage>0.70</jacoco.minimum.coverage>
    <!-- The JUnit tags Surefire skips by default; -Pall-tests runs every test (build-and-test.md, "Test tags") -->
    <excludedGroups>extremely-slow</excludedGroups>
  </properties>

  <!-- Compile scope: this is a test library, and its users' tests run on these -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>org.opentest4j</groupId>
      <artifactId>opentest4j</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Runs every test, the tags the default build skips included: mvn verify -Pall-tests -->
    <profile>
      <id>all-tests</id>
      <properties>
        <excludedGroups></excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
