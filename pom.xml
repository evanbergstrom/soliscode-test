<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.soliscode</groupId>
    <artifactId>soliscode-parent</artifactId>
    <version>1.0.5</version>
  </parent>

  <!-- Project Coordinates -->
  <artifactId>soliscode-test</artifactId>
  <!-- Keep development on a SNAPSHOT so publish:snapshot has something to push.
       semantic-release will set a non-SNAPSHOT for releases, then bump back. -->
  <version>1.0.14-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!-- Project Information -->
  <name>SolisCode Test</name>
  <description>Library for writing unit tests for classes that implement standard interfaces</description>
  <url>https://soliscode.org</url>
  <inceptionYear>2025</inceptionYear>

  <!-- Legal Information -->
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE.txt</url>
    </license>
  </licenses>

  <!-- People and Contributors -->
  <developers>
    <developer>
      <id>evanbergstrom</id>
      <name>Evan Bergstrom</name>
      <email>evan.bergstrom@icloud.com</email>
      <organization>soliscode</organization>
      <url>https://www.evanbergstrom.com</url>
      <timezone>America/New_York</timezone>
      <roles>
        <role>owner</role>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <!-- Source Control -->
  <scm>
    <connection>scm:git@gitlab.com:soliscode/soliscode-test.git</connection>
    <developerConnection>scm:git:ssh://git@gitlab.com:soliscode/soliscode-test.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://gitlab.com/soliscode/soliscode-test.git</url>
  </scm>

  <!-- Continuous Integration -->
  <ciManagement>
    <system>GitLab CI</system>
    <url>https://gitlab.com/soliscode/soliscode-test/-/pipelines</url>
  </ciManagement>

  <!-- Distribution Management -->
  <distributionManagement>
    <!-- release repository and snapshot repository managed by parent -->
    <site>
      <id>${project.artifactId}-site</id>
      <name>SolisCode Test Site</name>
      <url>${project.baseUri}</url>
    </site>
  </distributionManagement>

  <!-- Properties -->
  <properties>
    <!-- Only project-specific properties that aren't inherited from parent -->
    <javaDocStylesheetPath>${basedir}/src/main/javadoc/stylesheet.css</javaDocStylesheetPath>
    <!-- Override checkstyle version to match parent resources -->
    <soliscode.checkstyle.version> ${project.parent.version}</soliscode.checkstyle.version>
  </properties>

  <!-- Dependency Management -->
  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- Versions managed by parent pom dependencyManagement -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-testkit</artifactId>
    </dependency>
  </dependencies>


  <build>
    <plugins>
      <!-- Most plugins are fully configured in parent pom pluginManagement -->
      <!-- Only include plugins that need project-specific configuration -->

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <failOnError>true</failOnError>           <!-- default: true -->
          <failOnWarnings>true</failOnWarnings>     <!-- default: false -->
          <doclint>all</doclint>                    <!-- treat warnings as errors -->
          <additionalOptions>
            <additionalOption>-Werror</additionalOption>
          </additionalOptions>
        </configuration>
      </plugin>

      <!-- JaCoCo with project-specific report-aggregate execution -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <inherited>false</inherited>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Central Publishing Plugin (project-specific configuration) -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
          <waitUntil>validated</waitUntil>
          <centralSnapshotsUrl>https://central.sonatype.com/repository/maven-snapshots/</centralSnapshotsUrl>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <reporting>
    <plugins>
      <!-- Only project-specific reporting configuration -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-report-plugin</artifactId>
        <configuration>
          <aggregate>true</aggregate>
          <linkXRef>true</linkXRef>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>report</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>aggregate</id>
            <inherited>false</inherited>
            <reports>
              <report>aggregate</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>report-aggregate</id>
            <inherited>false</inherited>
            <reports>
              <report>report-aggregate</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>