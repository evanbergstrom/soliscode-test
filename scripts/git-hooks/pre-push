# Refuses a push to main that sends a commit which did not pass the pre-commit hook here, such as
# one made with --no-verify (docs/design/reference/build-and-test.md, "Git hooks").
# Git gives the remote's name as $1 and one line per ref on standard input:
#   <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

remote="$1"
root=$(git rev-parse --show-toplevel)
# shellcheck source=../lib/records.sh
source "$root/scripts/lib/records.sh"
records="$(records_dir)/pre-commit"
zero=0000000000000000000000000000000000000000

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$remote_ref" == "refs/heads/main" ]] || continue
    [[ "$local_sha" != "$zero" ]] || continue    # a deletion

    if [[ "$remote_sha" == "$zero" ]]; then
        commits=$(git rev-list "$local_sha" --not --remotes="$remote")
    elif git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        commits=$(git rev-list "$remote_sha..$local_sha")
    else
        echo "pre-push: $remote's main ($remote_sha) is not here; fetch first" >&2
        exit 1
    fi

    for c in $commits; do
        tree=$(git rev-parse "$c^{tree}")
        if [[ ! -e "$records/$tree" ]]; then
            echo "pre-push: $(git log -1 --format='%h %s' "$c") did not pass the pre-commit hook" \
                "(committed with --no-verify?). Commit it again with the hook before pushing to main." >&2
            status=1
        fi
    done
done
exit $status
